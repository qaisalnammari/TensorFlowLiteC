# Single place to change the TensorFlowLiteC version (stay within 2.11.x for vendor SDK compatibility).
TFLITE_VERSION="2.11.0"

# Official CocoaPods spec (Trunk CDN). Used to resolve the dl.google.com tarball URL.
TFLITE_PODSPEC_URL="https://cdn.cocoapods.org/Specs/1/6/0/TensorFlowLiteC/${TFLITE_VERSION}/TensorFlowLiteC.podspec.json"
